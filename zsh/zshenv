# ~/.zshenv — the first file zsh reads for every shell (login, interactive, script).
# Keep this minimal: only what MUST exist before .zprofile/.zshrc run.

# XDG base directories.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Relocate zsh's own dotfiles into $XDG_CONFIG_HOME/zsh so $HOME stays clean.
# Everything below this line lives in $ZDOTDIR (.zprofile, .zshrc, ...).
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Hermes Agent CLI (managed venv). Appended, not prepended: the venv's generic
# python/pip must not shadow user binaries in ~/.local/bin or Homebrew.
export PATH="$PATH:$HOME/.hermes/hermes-agent/venv/bin"

# Local secrets (API keys) — file is 0600 and NOT git-tracked. Sourced here in
# ~/.zshenv (NOT .zshrc) because ~/.zshenv is read by EVERY zsh shell — login,
# interactive, AND non-login pane shells (e.g. codex/hdr agents spawned into a
# herdr/tmux pane). .zshrc is skipped by non-login shells, which is why BYOK
# codex models (deepseek/openrouter) were silently missing their keys.
[[ -f "$ZDOTDIR/secrets.zsh" ]] && source "$ZDOTDIR/secrets.zsh"

# Synergy: one Nx cache shared by every lane worktree (owner 2026-10-29).
# CI is unaffected (no zshenv there; nx.json keeps .nx/cache).
export NX_CACHE_DIRECTORY="$HOME/.cache/nx/synergy-apps"
