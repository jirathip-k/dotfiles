{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/deepseek-v4-flash",
  "instructions": ["instructions.md"],
  "lsp": true,
  "formatter": true,
  // Command Code (GOAT plan) via its OpenAI-compatible Provider API.
  // Second provider for DeepSeek V4 Flash so an opencode-go outage or a
  // drained balance can't idle every fleet at once.
  // Key lives in ~/.local/share/opencode/auth.json (opencode auth login),
  // never in this git-tracked file.
  "provider": {
    "commandcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Command Code",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (CC)",
          "tool_call": true,
          "reasoning": true,
          "limit": { "context": 1000000, "output": 384000 },
          "cost": { "input": 0.22, "output": 0.66, "cache_read": 0.007 }
        }
      }
    }
  },
  "mcp": {
    "supabase-readonly": {
      "type": "remote",
      "url": "https://mcp.supabase.com/mcp?read_only=true",
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "question": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow"
    }
  }
}
